{
  "name": "axcellera",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-29",
  "observability": { "enabled": true },

  // O Worker só roda para /api/*; todo o resto é servido direto como asset estático.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Remetente e destinatário do e-mail do formulário (enviado pela API do Brevo).
  // O remetente precisa estar em um domínio autenticado no Brevo.
  "vars": {
    "CONTACT_TO": "contato@axcellera.com.br",
    "CONTACT_FROM": "site@axcellera.com.br"
  }
  // Secrets (não ficam neste arquivo): TURNSTILE_SECRET_KEY e BREVO_API_KEY
}
